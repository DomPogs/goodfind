APP_URL=http://localhost/goodfind
PLATFORM_CURRENCY=php
APP_DEBUG=0

# MySQL/MariaDB connection (import database/schema.sql in phpMyAdmin first)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=youfind
DB_USER=root
DB_PASSWORD=
OPENSSL_BIN=C:\xampp\apache\bin\openssl.exe

# Create a member account, then set its email here to grant admin access.
ADMIN_EMAIL=

# Stripe Connect (test mode first)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Required before checkout. Set the fee you have chosen; 100 basis points = 1%.
PLATFORM_FEE_BPS=
